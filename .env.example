# Copy to .env for local Compose use. These are placeholders, not credentials.
POSTGRES_DB=mythoslive
POSTGRES_USER=mythos
BUILD_VERSION=local
DATABASE_URL=postgresql+asyncpg://mythos@db:5432/mythoslive
CORS_ORIGINS=["http://localhost:3000"]
ENCRYPTION_KEY=
# Leave unset until an embedding model is selected; pgvector then stores variable dimensions.
EMBEDDING_DIMENSION=
NEXT_PUBLIC_API_URL=http://localhost:8000
AI_API_BASE_URL=
AI_API_KEY=
AI_DIRECTOR_MODEL=
AI_FAST_MODEL=
AI_EMBEDDING_MODEL=
AI_MODERATION_MODEL=
AI_TIMEOUT_SECONDS=4.0
AI_MAX_RETRIES=1
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_SECONDS=30
AI_SESSION_TOKEN_BUDGET=20000
AI_SESSION_COST_BUDGET_USD=1.0
AI_INPUT_COST_PER_MILLION=0.0
AI_OUTPUT_COST_PER_MILLION=0.0
AI_TONE=heroic
AI_FAMILY_FRIENDLY=true
AI_BANNED_TOPICS=[]
AI_APPROVAL_MODE=required
QUILL_USER_COOLDOWN_SECONDS=30
QUILL_GLOBAL_MESSAGES_PER_MINUTE=6
MEMORY_CONTEXT_LIMIT=6
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_REDIRECT_URI=http://localhost:8000/api/twitch/oauth/broadcaster/callback
TWITCH_BOT_REDIRECT_URI=http://localhost:8000/api/twitch/oauth/bot/callback
TWITCH_EVENTSUB_URL=wss://eventsub.wss.twitch.tv/ws
EVENTSUB_MAX_RETRIES=10
CHAT_OUTBOX_MAX_SIZE=200
CHAT_OUTBOX_BATCH_MAX_SIZE=20
CHAT_GLOBAL_MESSAGES_PER_30_SECONDS=20
CHAT_CHANNEL_INTERVAL_SECONDS=1.0
CHAT_MAX_MESSAGE_LENGTH=500
COMMAND_MAX_INPUT_LENGTH=500
COMMAND_GLOBAL_PER_SECOND=100
COMMAND_USER_COOLDOWN_SECONDS=0.5
