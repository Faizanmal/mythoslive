# Copy to .env.production on the VM and edit with a secure editor. Never commit the real file.
COMPOSE_PROJECT_NAME=mythoslive-prod
MYTHOSLIVE_BACKEND_IMAGE=mythoslive-backend:release-2026-11-03-01
BUILD_VERSION=release-2026-11-03-01

# Port 8000 belongs to another app. Verify 8001 is still free before startup.
# Override only after inspecting listeners and updating the proxy upstream.
API_HOST_PORT=8001

POSTGRES_DB=mythoslive
POSTGRES_USER=mythos
# Generate hex-only passwords so DATABASE_URL needs no URL escaping.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DATABASE_URL=postgresql+asyncpg://mythos:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/mythoslive

# Exact Netlify frontend origin (replace with your real https://….netlify.app URL).
CORS_ORIGINS=["https://REPLACE-WITH-YOUR-SITE.netlify.app"]
ENCRYPTION_KEY=REPLACE_WITH_VALID_FERNET_KEY

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_REDIRECT_URI=https://mythos-api.faizanmalik.me/api/twitch/oauth/broadcaster/callback
TWITCH_BOT_REDIRECT_URI=https://mythos-api.faizanmalik.me/api/twitch/oauth/bot/callback
TWITCH_EVENTSUB_URL=wss://eventsub.wss.twitch.tv/ws
TWITCH_EVENTSUB_KEEPALIVE_TIMEOUT=30
EVENTSUB_MAX_RETRIES=10
SIM_WORLD_ID=6c9f5a98-8f43-5bd5-a263-239ea8b494fc

# Optional AI; leave blank to use deterministic narration and content.
AI_API_BASE_URL=
AI_API_KEY=
AI_DIRECTOR_MODEL=
AI_FAST_MODEL=
AI_EMBEDDING_MODEL=
AI_MODERATION_MODEL=
EMBEDDING_DIMENSION=
AI_TIMEOUT_SECONDS=4.0
AI_MAX_RETRIES=1
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_SECONDS=30
AI_SESSION_TOKEN_BUDGET=20000
AI_SESSION_COST_BUDGET_USD=1.0
AI_INPUT_COST_PER_MILLION=0.0
AI_OUTPUT_COST_PER_MILLION=0.0
AI_TONE=heroic
AI_FAMILY_FRIENDLY=true
AI_BANNED_TOPICS=[]
AI_APPROVAL_MODE=required
QUILL_USER_COOLDOWN_SECONDS=30
QUILL_GLOBAL_MESSAGES_PER_MINUTE=6
MEMORY_CONTEXT_LIMIT=6

# Private persistent Redis is provisioned by Compose but not yet integrated by application code.
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
